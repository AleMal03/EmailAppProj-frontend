<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<VBox alignment="CENTER" prefHeight="318.0" prefWidth="476.0" spacing="15.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mailproject.mailclient.controllers.LoginController">
   <children>
      <HBox alignment="CENTER">
         <children>
            <Label fx:id="lblEmailAddr" contentDisplay="CENTER" prefHeight="22.0" prefWidth="110.0" text="Indirizzo email:">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
            <TextField fx:id="txtEmailAddr" promptText="esempio@mail.com">
               <font>
                  <Font size="14.0" />
               </font>
            </TextField>
         </children>
         <VBox.margin>
            <Insets bottom="15.0" />
         </VBox.margin>
      </HBox>
      <Button fx:id="btnLogin" alignment="CENTER" mnemonicParsing="false" onAction="#onLoginBtnClick" prefHeight="30.0" prefWidth="110.0" text="LOGIN">
         <font>
            <Font size="14.0" />
         </font>
      </Button>
      <Label fx:id="lblLoginError" alignment="CENTER" prefHeight="22.0" prefWidth="319.0" textFill="RED" />
   </children>
</VBox>
