<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="boxLogin" alignment="CENTER" prefHeight="318.0" prefWidth="476.0" spacing="18.0" styleClass="appBackground" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mailproject.mailclient.controllers.LoginController">
   <children>
      <Label alignment="CENTER" contentDisplay="CENTER" styleClass="mainText" text="Benvenuto nel tuo client di posta">
         <font>
            <Font size="40.0" />
         </font>
      </Label>
      <HBox alignment="CENTER" spacing="12.0">
         <children>
            <Label fx:id="lblEmailAddr" contentDisplay="CENTER" prefHeight="22.0" prefWidth="110.0" styleClass="mainText" text="Indirizzo email:">
               <font>
                  <Font size="16.0" />
               </font>
            </Label>
            <TextField fx:id="txtEmailAddr" promptText="esempio@mail.com" >
               <font>
                  <Font size="14.0" />
               </font>
            </TextField>
         </children>
         <VBox.margin>
            <Insets bottom="15.0" />
         </VBox.margin>
      </HBox>
      <Button fx:id="btnLogin" alignment="CENTER" defaultButton="true" mnemonicParsing="false" onAction="#onLoginBtnClick" style="-fx-font-size: 20;" text="LOGIN">
         <font>
            <Font size="14.0" />
         </font>
         <styleClass>
            <String fx:value="btn" />
            <String fx:value="actionText" />
            <String fx:value="btnAction" />
         </styleClass>
      </Button>
      <Label fx:id="lblLoginError" alignment="CENTER" prefHeight="22.0" prefWidth="319.0" textFill="RED" />
   </children>
</VBox>
